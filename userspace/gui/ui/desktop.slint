import { DesktopBackground } from "components/background/background.slint";
import { VoidWindow } from "components/window/window.slint";
import { DefaultDock } from "components/dock/default/dock.slint";

export struct AppSurface {
    kind: int,
    title: string,
    pixels: image,
    client-width: length,
    client-height: length,
    pos-x: length,
    pos-y: length,
    minimized: bool,
    scale-progress: float,
}

export component VoidDesktop inherits Window {
    width: 1280px;
    height: 720px;
    title: "VoidOS Desktop";

    in-out property <int> dock-mode: 0;
    in-out property <bool> dock-visible: true;
    in-out property <image> dock-backdrop;
    in-out property <bool> terminal-open: true;
    in-out property <bool> sysmon-open: false;
    in-out property <bool> files-open: false;
    in-out property <int> focused-window: 0;
    in-out property <string> overlay-text: "";
    in-out property <string> status: "";
    in-out property <[AppSurface]> surfaces: [];
    in-out property <string> display-label: "15:44";
    in-out property <string> uptime-label: "24 Nov 2026";
    in-out property <length> cursor-x: 540px;
    in-out property <length> cursor-y: 380px;

    callback launch-app(int);
    callback close-app(int);
    callback minimize-app(int);
    callback quit-desktop();

    // Layer 0: Wallpaper background (no VoidOS text on top)
    DesktopBackground {
        width: root.width;
        height: root.height;
    }

    // Layer 1: Live application surfaces from real Ring 3 processes
    for surface in root.surfaces: VoidWindow {
        property <float> p: surface.scale-progress;
        property <length> full-w: surface.client-width + 2px;
        property <length> full-h: surface.client-height + 34px;
        visible: !surface.minimized && p > 0.01;
        x: surface.pos-x + (1.0 - p) * full-w * 0.08;
        y: surface.pos-y + (1.0 - p) * full-h * 0.08;
        width: full-w * (0.84 + 0.16 * p);
        height: full-h * (0.84 + 0.16 * p);
        opacity: p;
        app-kind: surface.kind;
        title: surface.title;
        focused: root.focused-window == surface.kind;
        minimize-clicked => {
            root.minimize-app(surface.kind);
        }
        close-clicked => {
            if (surface.kind == 0) {
                root.terminal-open = false;
            }
            if (surface.kind == 1) {
                root.sysmon-open = false;
            }
            if (surface.kind == 2) {
                root.files-open = false;
            }
            root.close-app(surface.kind);
        }

        Image {
            width: 100%;
            height: 100%;
            source: surface.pixels;
            image-rendering: pixelated;
        }
    }

    // Fallback / preview light-theme Terminal window when no external SHM surface is attached yet
    if root.surfaces.length == 0 && root.terminal-open: VoidWindow {
        x: (root.width - self.width) / 2;
        y: 84px;
        width: 640px;
        height: 380px;
        title: "Terminal";
        focused: true;
        close-clicked => {
            root.terminal-open = false;
            root.close-app(0);
        }

        Rectangle {
            background: #F9FBFFE0;
            VerticalLayout {
                padding: 14px;
                spacing: 7px;
                alignment: start;

                Text { text: "void> print VoidOS Ready"; color: #4A5570; font-size: 12px; font-weight: 600; }
                Text { text: "VoidOS Ready"; color: #1E2436; font-size: 12px; }
                Text { text: "void> fl /"; color: #4A5570; font-size: 12px; font-weight: 600; }
                Text { text: "HELLO.TXT   BIN/   ETC/"; color: #1E2436; font-size: 12px; }
                Text { text: "void> rp /HELLO.TXT"; color: #4A5570; font-size: 12px; font-weight: 600; }
                Text { text: "VoidOS FAT32 disk ok"; color: #1E2436; font-size: 12px; }
                Text { text: "void> _"; color: #1E2436; font-size: 12px; font-weight: 700; }
            }
        }
    }

    // Layer 2: Compact Liquid Glass 3-zone Dock
    DefaultDock {
        visible: root.dock-visible;
        backdrop-image: root.dock-backdrop;
        screen-width: root.width;
        screen-height: root.height;
        dock-mode: root.dock-mode;
        terminal-open: root.terminal-open;
        sysmon-open: root.sysmon-open;
        files-open: root.files-open;
        clock-text: root.display-label;
        sub-clock-text: root.uptime-label;
        toggle-terminal => {
            if (root.terminal-open) {
                root.terminal-open = false;
                root.close-app(0);
            } else {
                root.terminal-open = true;
                root.launch-app(0);
            }
        }
        toggle-sysmon => {
            if (root.sysmon-open) {
                root.sysmon-open = false;
                root.close-app(1);
            } else {
                root.sysmon-open = true;
                root.launch-app(1);
            }
        }
        toggle-files => {
            if (root.files-open) {
                root.files-open = false;
                root.close-app(2);
            } else {
                root.files-open = true;
                root.launch-app(2);
            }
        }
        shutdown-clicked => {
            root.quit-desktop();
        }
    }
}
