import { DesktopBackground } from "components/background/background.slint";
import { VoidWindow } from "components/window/window.slint";
import { DefaultDock } from "components/dock/default/dock.slint";

export struct AppSurface {
    kind: int,
    title: string,
    pixels: image,
    client-width: length,
    client-height: length,
    view-width: length,
    view-height: length,
    pos-x: length,
    pos-y: length,
    minimized: bool,
    maximized: bool,
    corner-top-radius: length,
    corner-bottom-radius: length,
    scale-progress: float,
    anim-kind: int,
}

export component VoidDesktop inherits Window {
    in-out property <length> screen-w: 1280px;
    in-out property <length> screen-h: 720px;
    width: root.screen-w;
    height: root.screen-h;
    title: "VoidOS Desktop";

    in-out property <int> dock-mode: 0;
    in-out property <bool> dock-visible: true;
    in-out property <bool> surfaces-visible: true;
    in-out property <image> dock-backdrop;
    in-out property <bool> wallpaper-cached: false;
    in-out property <image> cached-wallpaper;
    in-out property <bool> terminal-open: true;
    in-out property <bool> sysmon-open: false;
    in-out property <bool> files-open: false;
    in-out property <bool> terminal-minimized: false;
    in-out property <bool> sysmon-minimized: false;
    in-out property <bool> files-minimized: false;
    in-out property <int> focused-window: 0;
    in-out property <string> overlay-text: "";
    in-out property <string> status: "";
    in-out property <[AppSurface]> surfaces: [];
    in-out property <string> display-label: "15:44";
    in-out property <string> uptime-label: "24 Nov 2026";
    in-out property <length> cursor-x: 540px;
    in-out property <length> cursor-y: 380px;
    in-out property <bool> search-active: false;
    in-out property <string> search-query: "";
    in-out property <string> search-hint: "Terminale | Monitor | File";

    callback launch-app(int);
    callback close-app(int);
    callback minimize-app(int);
    callback maximize-app(int);
    callback quit-desktop();
    callback toggle-search();

    // Layer 0: Wallpaper background (1:1 screen-cached after startup for lag-free window drag)
    DesktopBackground {
        width: root.width;
        height: root.height;
        use-cached: root.wallpaper-cached;
        cached-wallpaper: root.cached-wallpaper;
    }

    // Layer 1: Live application surfaces from real Ring 3 processes
    for surface in root.surfaces: VoidWindow {
        property <float> p: surface.scale-progress;
        property <length> full-w: surface.view-width + 2px;
        property <length> full-h: surface.view-height + 34px;
        property <float> min-scale: surface.anim-kind == 2 ? 0.50 : (surface.anim-kind == 1 ? 0.72 : 0.80);
        property <float> scale: min-scale + (1.0 - min-scale) * p;
        property <length> slide-y: surface.anim-kind == 2 ? (1.0 - p) * 44px : (surface.anim-kind == 0 ? (1.0 - p) * 16px : 0px);
        visible: root.surfaces-visible && !surface.minimized && p > 0.01;
        x: surface.pos-x + (1.0 - scale) * full-w * 0.5;
        y: surface.pos-y + (1.0 - scale) * full-h * 0.5 + slide-y;
        width: full-w * scale;
        height: full-h * scale;
        opacity: p < 0.99 ? p : 1.0;
        app-kind: surface.kind;
        title: surface.title;
        focused: root.focused-window == surface.kind;
        maximized: surface.maximized;
        corner-top-radius: surface.corner-top-radius;
        corner-bottom-radius: surface.corner-bottom-radius;
        minimize-clicked => {
            root.minimize-app(surface.kind);
        }
        maximize-clicked => {
            root.maximize-app(surface.kind);
        }
        close-clicked => {
            if (surface.kind == 0) {
                root.terminal-open = false;
                root.terminal-minimized = false;
            }
            if (surface.kind == 1) {
                root.sysmon-open = false;
                root.sysmon-minimized = false;
            }
            if (surface.kind == 2) {
                root.files-open = false;
                root.files-minimized = false;
            }
            root.close-app(surface.kind);
        }

        Image {
            width: 100%;
            height: 100%;
            source: surface.pixels;
            image-fit: fill;
            image-rendering: pixelated;
        }
    }

    // Fallback / preview light-theme Terminal window when no external SHM surface is attached yet
    if root.surfaces.length == 0 && root.terminal-open: VoidWindow {
        x: (root.width - self.width) / 2;
        y: 84px;
        width: 640px;
        height: 380px;
        title: "Terminal";
        focused: true;
        close-clicked => {
            root.terminal-open = false;
            root.close-app(0);
        }

        Rectangle {
            background: #F9FBFFE0;
            VerticalLayout {
                padding: 14px;
                spacing: 7px;
                alignment: start;

                Text { text: "void> print VoidOS Ready"; color: #4A5570; font-size: 12px; font-weight: 600; }
                Text { text: "VoidOS Ready"; color: #1E2436; font-size: 12px; }
                Text { text: "void> fl /"; color: #4A5570; font-size: 12px; font-weight: 600; }
                Text { text: "HELLO.TXT   BIN/   ETC/"; color: #1E2436; font-size: 12px; }
                Text { text: "void> rp /HELLO.TXT"; color: #4A5570; font-size: 12px; font-weight: 600; }
                Text { text: "VoidOS FAT32 disk ok"; color: #1E2436; font-size: 12px; }
                Text { text: "void> _"; color: #1E2436; font-size: 12px; font-weight: 700; }
            }
        }
    }

    // Search suggestion popup above the dock search bar
    if root.dock-visible && root.search-active: Rectangle {
        x: 96px;
        y: root.height - 104px;
        width: 240px;
        height: 34px;
        border-radius: 12px;
        border-width: 1px;
        border-color: #3B82F6AA;
        background: #F8FAFFE8;

        Text {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            vertical-alignment: center;
            font-size: 12px;
            font-weight: 600;
            color: #0F172A;
            text: root.search-hint;
        }
    }

    // Layer 2: Default Dock
    DefaultDock {
        visible: root.dock-visible;
        backdrop-image: root.dock-backdrop;
        screen-width: root.width;
        screen-height: root.height;
        dock-mode: root.dock-mode;
        terminal-open: root.terminal-open;
        sysmon-open: root.sysmon-open;
        files-open: root.files-open;
        terminal-minimized: root.terminal-minimized;
        sysmon-minimized: root.sysmon-minimized;
        files-minimized: root.files-minimized;
        clock-text: root.display-label;
        sub-clock-text: root.uptime-label;
        search-active: root.search-active;
        search-query: root.search-query;
        search-clicked => {
            root.toggle-search();
        }
        toggle-terminal => {
            if (root.terminal-open) {
                root.terminal-open = false;
                root.close-app(0);
            } else {
                root.terminal-open = true;
                root.terminal-minimized = false;
                root.launch-app(0);
            }
        }
        toggle-sysmon => {
            if (root.sysmon-open) {
                root.sysmon-open = false;
                root.close-app(1);
            } else {
                root.sysmon-open = true;
                root.sysmon-minimized = false;
                root.launch-app(1);
            }
        }
        toggle-files => {
            if (root.files-open) {
                root.files-open = false;
                root.close-app(2);
            } else {
                root.files-open = true;
                root.files-minimized = false;
                root.launch-app(2);
            }
        }
        shutdown-clicked => {
            root.quit-desktop();
        }
    }
}
