// Layer 1: Light-theme window with slim titlebar (32px), terminal.png icon,
// and 3 compact Windows-style bordered mini-squares on the right (22x22).
export component VoidWindow inherits Rectangle {
    in property <string> title: "Terminal";
    in property <int> app-kind: 0;
    in property <bool> focused: true;
    callback close-clicked();
    callback minimize-clicked();

    background: #F4F7FEF2;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.focused ? #5B71A0C8 : #94A3B888;
    clip: true;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Liquid-glass Titlebar (32px height, dragged by compositor in absolute screen coordinates)
        Rectangle {
            height: 32px;
            background: root.focused
                ? @linear-gradient(180deg, #FFFFFFF0 0%, #EAF0FBE8 100%)
                : @linear-gradient(180deg, #F5F8FDE0 0%, #E6ECF8D8 100%);

            // Top specular Liquid Glass rim
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 1px;
                background: #FFFFFFEE;
            }

            // Bottom subtle divider between titlebar and client surface
            Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: #7E8BA838;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 7px;
                padding-top: 5px;
                padding-bottom: 5px;
                alignment: space-between;

                // Left: App-specific icon + compact window title
                HorizontalLayout {
                    spacing: 7px;
                    alignment: start;

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: #FFFFFFCC;
                        background: @linear-gradient(180deg, #FFFFFFAA 0%, #E8EEF978 100%);

                        if root.app-kind == 0: Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 15px;
                            height: 15px;
                            source: @image-url("../../../application/terminal/icon/terminal.png");
                        }

                        if root.app-kind == 1: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: transparent;
                            Rectangle { x: 4px;  y: 11px; width: 3px; height: 6px;  border-radius: 1px; background: #22C55E; }
                            Rectangle { x: 9px;  y: 6px;  width: 3px; height: 11px; border-radius: 1px; background: #3B82F6; }
                            Rectangle { x: 14px; y: 8px;  width: 3px; height: 9px;  border-radius: 1px; background: #6366F1; }
                        }

                        if root.app-kind == 2: Rectangle {
                            width: 100%;
                            height: 100%;
                            background: transparent;
                            Rectangle { x: 4px; y: 6px;  width: 6px;  height: 3px; border-radius: 1px; background: #D97706; }
                            Rectangle { x: 4px; y: 8px;  width: 14px; height: 9px; border-radius: 2px; background: #F59E0B; }
                            Rectangle { x: 5px; y: 10px; width: 12px; height: 1.5px; border-radius: 1px; background: #FDE68A; }
                        }
                    }

                    Text {
                        text: root.title;
                        color: root.focused ? #161C2C : #47526B;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Right: 3 compact Liquid Glass mini-squares (22x22)
                HorizontalLayout {
                    spacing: 5px;
                    alignment: end;

                    // Minimize square (—)
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: min-ta.has-hover ? #5E6E94B8 : #8896B270;
                        background: min-ta.has-hover ? #FFFFFFDD : #FFFFFF72;
                        animate background { duration: 140ms; easing: ease-out; }
                        animate border-color { duration: 140ms; easing: ease-out; }
                        min-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.minimize-clicked(); }
                        }
                        Rectangle {
                            x: 7px;
                            y: 10.5px;
                            width: 8px;
                            height: 1.4px;
                            border-radius: 0.7px;
                            background: #22283A;
                        }
                    }

                    // Maximize square (□)
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: max-ta.has-hover ? #5E6E94B8 : #8896B270;
                        background: max-ta.has-hover ? #FFFFFFDD : #FFFFFF72;
                        animate background { duration: 140ms; easing: ease-out; }
                        animate border-color { duration: 140ms; easing: ease-out; }
                        max-ta := TouchArea { mouse-cursor: pointer; }
                        Rectangle {
                            x: 7px;
                            y: 7px;
                            width: 8px;
                            height: 8px;
                            border-radius: 1.5px;
                            border-width: 1.4px;
                            border-color: #22283A;
                            background: transparent;
                        }
                    }

                    // Close square (×) — neutral Liquid Glass hover, geometrically centered vector X
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 7px;
                        border-width: 1px;
                        border-color: close-ta.has-hover ? #5E6E94B8 : #8896B270;
                        background: close-ta.has-hover ? #FFFFFFDD : #FFFFFF72;
                        animate background { duration: 140ms; easing: ease-out; }
                        animate border-color { duration: 140ms; easing: ease-out; }
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-clicked(); }
                        }
                        // Pixel-centered geometric X (22x22 box, 1.5px stroke matching - and [])
                        Rectangle { x: 7.25px;  y: 7.25px;  width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 8.25px;  y: 8.25px;  width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 9.25px;  y: 9.25px;  width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 10.25px; y: 10.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 11.25px; y: 11.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 12.25px; y: 12.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 13.25px; y: 13.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 13.25px; y: 7.25px;  width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 12.25px; y: 8.25px;  width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 11.25px; y: 9.25px;  width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 9.25px;  y: 11.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 8.25px;  y: 12.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                        Rectangle { x: 7.25px;  y: 13.25px; width: 1.5px; height: 1.5px; background: #22283A; }
                    }
                }
            }
        }

        // Crisp 1px separator line
        Rectangle {
            height: 1px;
            background: #C4CCDE88;
        }

        // Window content area
        Rectangle {
            vertical-stretch: 1;
            @children
        }
    }
}
