// Layer 1: Light-theme window with slim titlebar (32px), terminal.png icon,
// and 3 compact Windows-style bordered mini-squares on the right (22x22).
export component VoidWindow inherits Rectangle {
    in property <string> title: "Terminal";
    in property <bool> focused: true;
    callback close-clicked();
    callback minimize-clicked();

    background: #F7F9FFF0;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.focused ? #4F6490CC : #94A3B899;
    clip: true;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Compact Titlebar (32px height, dragged by compositor in absolute screen coordinates)
        Rectangle {
            height: 32px;
            background: root.focused ? #E6ECFBF0 : #EEF2FBE8;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 7px;
                padding-top: 5px;
                padding-bottom: 5px;
                alignment: space-between;

                // Left: Terminal icon + compact window title
                HorizontalLayout {
                    spacing: 7px;
                    alignment: start;

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #8896B278;
                        background: #FFFFFF78;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../../../application/terminal/icon/terminal.png");
                        }
                    }

                    Text {
                        text: root.title;
                        color: #1E2436;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Right: 3 compact Windows-style mini-squares (22x22) with Dock-like border frame
                HorizontalLayout {
                    spacing: 5px;
                    alignment: end;

                    // Minimize square (—)
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: min-ta.has-hover ? #5E6E94AA : #8896B280;
                        background: min-ta.has-hover ? #FFFFFFCC : #FFFFFF68;
                        animate background { duration: 150ms; easing: ease-out; }
                        animate border-color { duration: 150ms; easing: ease-out; }
                        min-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.minimize-clicked(); }
                        }
                        Rectangle {
                            x: 7px;
                            y: 11px;
                            width: 8px;
                            height: 1.4px;
                            background: #22283A;
                        }
                    }

                    // Maximize square (□)
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: max-ta.has-hover ? #5E6E94AA : #8896B280;
                        background: max-ta.has-hover ? #FFFFFFCC : #FFFFFF68;
                        animate background { duration: 150ms; easing: ease-out; }
                        animate border-color { duration: 150ms; easing: ease-out; }
                        max-ta := TouchArea { mouse-cursor: pointer; }
                        Rectangle {
                            x: 7px;
                            y: 7px;
                            width: 8px;
                            height: 8px;
                            border-radius: 1.5px;
                            border-width: 1.4px;
                            border-color: #22283A;
                            background: transparent;
                        }
                    }

                    // Close square (×)
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: close-ta.has-hover ? #DC2626AA : #8896B280;
                        background: close-ta.has-hover ? #FEE2E2CC : #FFFFFF68;
                        animate background { duration: 150ms; easing: ease-out; }
                        animate border-color { duration: 150ms; easing: ease-out; }
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.close-clicked(); }
                        }
                        Text {
                            text: "×";
                            color: close-ta.has-hover ? #B91C1C : #22283A;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Crisp 1px separator line
        Rectangle {
            height: 1px;
            background: #C4CCDE88;
        }

        // Window content area
        Rectangle {
            vertical-stretch: 1;
            @children
        }
    }
}
