// Layer 3: Overlay status pill / notification banner
export component OverlayPill inherits Rectangle {
    in property <string> message: "";
    in property <bool> shown: true;

    height: 30px;
    border-radius: 15px;
    background: #131A28E8;
    border-width: 1px;
    border-color: #3B82F6AA;
    opacity: root.shown ? 1.0 : 0.0;

    animate opacity { duration: 180ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;

        Text {
            text: root.message;
            color: #E2E8F0;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
