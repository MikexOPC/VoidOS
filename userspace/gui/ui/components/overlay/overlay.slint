// Layer 3: Subtle floating status pill
export component OverlayPill inherits Rectangle {
    in property <string> message: "";
    in property <bool> shown: false;

    width: 240px;
    height: 28px;
    border-radius: 14px;
    background: #FFFFFFE8;
    border-width: 1px;
    border-color: #DCE0F0;
    opacity: root.shown ? 1.0 : 0.0;

    animate opacity { duration: 160ms; easing: ease-out; }

    Text {
        text: root.message;
        color: #2D334A;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
