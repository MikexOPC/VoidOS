// Layer 0: User wallpaper background (cached 1:1 at screen resolution after frame 0 for fast drag)
export component DesktopBackground inherits Rectangle {
    in property <bool> use-cached: false;
    in property <image> cached-wallpaper;

    if !root.use-cached: Image {
        width: 100%;
        height: 100%;
        source: @image-url("wallpaper/wallpaper1.jpg");
        image-fit: cover;
    }

    if root.use-cached: Image {
        width: 100%;
        height: 100%;
        source: root.cached-wallpaper;
        image-fit: fill;
        image-rendering: pixelated;
    }
}
