// Layer 4: Software cursor — rounded pointer arrow (cursor.png)
export component SoftwareCursor inherits Rectangle {
    in property <length> pointer-x: 512px;
    in property <length> pointer-y: 384px;

    x: root.pointer-x;
    y: root.pointer-y;
    width: 24px;
    height: 24px;
    background: transparent;

    Image {
        width: 24px;
        height: 24px;
        source: @image-url("cursor.png");
    }
}
