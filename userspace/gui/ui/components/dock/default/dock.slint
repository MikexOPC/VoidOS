// Layer 2: Default Dock (userspace/gui/ui/components/dock/default/dock.slint)
// Frosted-glass blurred Dock:
//   - Real Gaussian-blurred backdrop (dock_blur.jpg) clipped inside border-radius: 14px + translucent glass tint
//   - Wider search-bar (216px) with uniform 8px spacing: shutdown <-> search-bar <-> app1
//   - Smooth Slint animations on hover, border, background, and active indicator
//   - Real hardware RTC clock & date from kernel bridge (SYS_DISPLAY_INFO)

export component DefaultDock inherits Rectangle {
    in property <length> screen-width: 1024px;
    in property <length> screen-height: 768px;
    in property <int> dock-mode: 0;
    in property <bool> terminal-open: true;
    in property <string> clock-text: "15:44";
    in property <string> sub-clock-text: "24 Nov 2026";

    callback toggle-terminal();
    callback shutdown-clicked();

    x: 44px;
    y: root.screen-height - 62px;
    width: root.screen-width - 88px;
    height: 50px;

    border-radius: 14px;
    background: transparent;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #080E1E44;

    // Clipped frosted-glass blur layer + translucent tint
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 14px;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../background/wallpaper/dock_blur.jpg");
            image-fit: cover;
        }

        // Translucent light frosted glass overlay
        Rectangle {
            width: 100%;
            height: 100%;
            background: #F4F7FF52;
            border-radius: 14px;
            border-width: 1px;
            border-color: #FFFFFF98;
        }

        // Subtle outer rim for contrast on any wallpaper
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 14px;
            border-width: 1px;
            border-color: #7E8BA85A;
            background: transparent;
        }

        dock-content := HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 8px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 8px;

            // 1) Shutdown button (38x38, no animation)
            shutdown-button := Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                border-width: 1px;
                border-color: shut-ta.has-hover ? #E06060CC : #8896B278;
                background: shut-ta.has-hover ? #FEE2E2CC : #FFFFFF58;

                shut-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.shutdown-clicked(); }
                }

                Image {
                    x: 10px;
                    y: 10px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../../../../libui/icons/on-off-button.png");
                    colorize: shut-ta.has-hover ? #DC2626 : #1E2436;
                }
            }

            // 2) Wider Search bar (216px, vertically centered inside 38px dock-content)
            Rectangle {
                width: 216px;
                height: 100%;
                background: transparent;

                search-bar := Rectangle {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: 100%;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 1px;
                    border-color: search-ta.has-hover ? #5E6E94AA : #8896B278;
                    background: search-ta.has-hover ? #FFFFFF84 : #FFFFFF60;
                    animate background { duration: 160ms; easing: ease-out; }
                    animate border-color { duration: 160ms; easing: ease-out; }

                    search-ta := TouchArea {
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        height: 100%;
                        width: 100%;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 14px;
                            height: 100%;
                            background: transparent;
                            Image {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../../../libui/icons/search.png");
                                colorize: #3A435E;
                            }
                        }

                        input := TextInput {
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: 600;
                            color: #1E2436;
                            text: "Search...";
                        }
                    }
                }
            }

            // 3) app-content: ONLY Terminal icon, centered in 38x38 tile
            app-content := HorizontalLayout {
                horizontal-stretch: 1;
                height: 100%;
                spacing: 8px;
                alignment: start;

                app1 := Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: term-ta.has-hover ? #4A5E90CC : (root.terminal-open ? #52648E99 : #8896B278);
                    background: term-ta.has-hover ? #FFFFFFA4 : (root.terminal-open ? #FFFFFF72 : #FFFFFF48);
                    animate background { duration: 160ms; easing: ease-out; }
                    animate border-color { duration: 160ms; easing: ease-out; }

                    term-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-terminal(); }
                    }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 24px;
                        height: 24px;
                        source: @image-url("../../../../application/terminal/icon/terminal.png");
                    }

                    // Animated active running pill at bottom of the tile
                    Rectangle {
                        x: root.terminal-open ? 12px : 19px;
                        y: 34px;
                        width: root.terminal-open ? 14px : 0px;
                        height: 2px;
                        border-radius: 1px;
                        background: #1E2436;
                        animate width { duration: 180ms; easing: ease-out; }
                        animate x { duration: 180ms; easing: ease-out; }
                    }
                }
            }

            // Subtle vertical divider before Utility Zone
            Rectangle {
                width: 1px;
                height: 24px;
                y: 7px;
                background: #7E8BA850;
            }

            // 4) utility-content: live status indicator + real RTC clock & date from kernel
            utility-content := HorizontalLayout {
                width: 158px;
                height: 100%;
                spacing: 6px;
                alignment: end;

                // Live system indicator pill
                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: 2px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: #8896B270;
                    background: #FFFFFF52;

                    Rectangle {
                        x: 11px;
                        y: 11px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #16A34A66;
                        background: #22C55E28;

                        Rectangle {
                            x: 3px;
                            y: 3px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: #16A34A;
                        }
                    }
                }

                // Real RTC Clock & Date box (bridged from kernel CMOS RTC)
                Rectangle {
                    width: 114px;
                    height: 34px;
                    y: 2px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: clock-ta.has-hover ? #5E6E94AA : #8896B278;
                    background: clock-ta.has-hover ? #FFFFFF84 : #FFFFFF58;
                    animate background { duration: 160ms; easing: ease-out; }
                    animate border-color { duration: 160ms; easing: ease-out; }

                    clock-ta := TouchArea {
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.clock-text;
                            color: #182032;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.sub-clock-text;
                            color: #46506A;
                            font-size: 9px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
