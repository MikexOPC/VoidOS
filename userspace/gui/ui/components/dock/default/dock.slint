// Layer 2: Default Dock (userspace/gui/ui/components/dock/default/dock.slint)
// Frosted-glass blurred Dock:
//   - Real Gaussian-blurred backdrop (dock_blur.jpg) clipped inside border-radius: 14px + translucent glass tint
//   - Wider search-bar (216px) with uniform 8px spacing: shutdown <-> search-bar <-> app1
//   - Smooth Slint animations on hover, border, background, and active indicator
//   - Real hardware RTC clock & date from kernel bridge (SYS_DISPLAY_INFO)

export component DefaultDock inherits Rectangle {
    in property <length> screen-width: 1280px;
    in property <length> screen-height: 720px;
    in property <int> dock-mode: 0;
    in property <bool> terminal-open: true;
    in property <bool> sysmon-open: false;
    in property <bool> files-open: false;
    in property <image> backdrop-image;
    in property <string> clock-text: "15:44";
    in property <string> sub-clock-text: "24 Nov 2026";

    callback toggle-terminal();
    callback toggle-sysmon();
    callback toggle-files();
    callback shutdown-clicked();

    x: 44px;
    y: root.screen-height - 62px;
    width: root.screen-width - 88px;
    height: 50px;

    border-radius: 16px;
    background: transparent;

    // Clipped native blurred wallpaper backdrop (clean blur, no Liquid Glass sheen)
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.backdrop-image;
            image-fit: fill;
        }

        // Subtle uniform neutral frost veil so icons and text stay crisp on any wallpaper
        Rectangle {
            width: 100%;
            height: 100%;
            background: #F4F7FC38;
        }
    }

    // Crisp single outer border around the dock
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        border-width: 1px;
        border-color: #FFFFFF7A;
        background: transparent;
    }

    dock-content := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

            // 1) Shutdown button (38x38, no animation)
            shutdown-button := Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 15px;
                border-width: 1px;
                border-color: #8896B278;
                background: #FFFFFF58;

                shut-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.shutdown-clicked(); }
                }

                Image {
                    x: 10px;
                    y: 10px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../../../../libui/icons/on-off-button.png");
                }
            }

            // 2) Wider Search bar (216px, vertically centered inside 38px dock-content)
            Rectangle {
                width: 216px;
                height: 100%;
                background: transparent;

                search-bar := Rectangle {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: 100%;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 1px;
                    border-color: search-ta.has-hover ? #5E6E94AA : #8896B278;
                    background: search-ta.has-hover ? #FFFFFF84 : #FFFFFF60;
                    animate background { duration: 160ms; easing: ease-out; }
                    animate border-color { duration: 160ms; easing: ease-out; }

                    search-ta := TouchArea {
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        height: 100%;
                        width: 100%;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 14px;
                            height: 100%;
                            background: transparent;
                            Image {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../../../libui/icons/search.png");
                                colorize: #3A435E;
                            }
                        }

                        input := TextInput {
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: 600;
                            color: #1E2436;
                            text: "Search...";
                        }
                    }
                }
            }

            // 3) app-content: fluid hover lift animation + Liquid Glass tiles
            app-content := HorizontalLayout {
                horizontal-stretch: 1;
                height: 100%;
                spacing: 8px;
                alignment: start;

                // App 1: Terminal
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: transparent;

                    app1 := Rectangle {
                        x: term-ta.has-hover ? -2px : 0px;
                        y: term-ta.has-hover ? -8px : 0px;
                        width: term-ta.has-hover ? 42px : 38px;
                        height: term-ta.has-hover ? 42px : 38px;
                        border-radius: term-ta.has-hover ? 13px : 11px;
                        border-width: 1px;
                        border-color: term-ta.has-hover ? #FFFFFFCC : (root.terminal-open ? #FFFFFF88 : #FFFFFF48);
                        background: term-ta.has-hover ? #FFFFFF96 : (root.terminal-open ? #FFFFFF58 : #FFFFFF34);
                        animate x { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate y { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate height { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate background { duration: 150ms; easing: ease-out; }
                        animate border-color { duration: 150ms; easing: ease-out; }

                        term-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-terminal(); }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: term-ta.has-hover ? 26px : 24px;
                            height: term-ta.has-hover ? 26px : 24px;
                            animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                            animate height { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                            source: @image-url("../../../../application/terminal/icon/terminal.png");
                        }

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 4px;
                            width: root.terminal-open ? 14px : 0px;
                            height: 2px;
                            border-radius: 1px;
                            background: #1E2436;
                            animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        }
                    }
                }

                // App 2: System Monitor
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: transparent;

                    app2 := Rectangle {
                        x: sysmon-ta.has-hover ? -2px : 0px;
                        y: sysmon-ta.has-hover ? -8px : 0px;
                        width: sysmon-ta.has-hover ? 42px : 38px;
                        height: sysmon-ta.has-hover ? 42px : 38px;
                        border-radius: sysmon-ta.has-hover ? 13px : 11px;
                        border-width: 1px;
                        border-color: sysmon-ta.has-hover ? #FFFFFFCC : (root.sysmon-open ? #FFFFFF88 : #FFFFFF48);
                        background: sysmon-ta.has-hover ? #FFFFFF96 : (root.sysmon-open ? #FFFFFF58 : #FFFFFF34);
                        animate x { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate y { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate height { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate background { duration: 150ms; easing: ease-out; }
                        animate border-color { duration: 150ms; easing: ease-out; }

                        sysmon-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-sysmon(); }
                        }

                        // Minimal 3-bar System Monitor icon (centered for 38px/42px)
                        Rectangle {
                            x: (parent.width - 20px) / 2;
                            y: (parent.height - 16px) / 2;
                            width: 20px;
                            height: 16px;
                            background: transparent;
                            Rectangle { x: 0px;  y: 6px; width: 5px; height: 10px; border-radius: 2px; background: #22C55E; }
                            Rectangle { x: 7px;  y: 0px; width: 5px; height: 16px; border-radius: 2px; background: #3B82F6; }
                            Rectangle { x: 14px; y: 3px; width: 5px; height: 13px; border-radius: 2px; background: #6366F1; }
                        }

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 4px;
                            width: root.sysmon-open ? 14px : 0px;
                            height: 2px;
                            border-radius: 1px;
                            background: #1E2436;
                            animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        }
                    }
                }

                // App 3: Files
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: transparent;

                    app3 := Rectangle {
                        x: files-ta.has-hover ? -2px : 0px;
                        y: files-ta.has-hover ? -8px : 0px;
                        width: files-ta.has-hover ? 42px : 38px;
                        height: files-ta.has-hover ? 42px : 38px;
                        border-radius: files-ta.has-hover ? 13px : 11px;
                        border-width: 1px;
                        border-color: files-ta.has-hover ? #FFFFFFCC : (root.files-open ? #FFFFFF88 : #FFFFFF48);
                        background: files-ta.has-hover ? #FFFFFF96 : (root.files-open ? #FFFFFF58 : #FFFFFF34);
                        animate x { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate y { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate height { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate background { duration: 150ms; easing: ease-out; }
                        animate border-color { duration: 150ms; easing: ease-out; }

                        files-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-files(); }
                        }

                        // Minimal folder icon (centered for 38px/42px)
                        Rectangle {
                            x: (parent.width - 22px) / 2;
                            y: (parent.height - 17px) / 2;
                            width: 22px;
                            height: 17px;
                            background: transparent;
                            Rectangle { x: 0px; y: 0px; width: 10px; height: 4px;  border-radius: 2px; background: #D97706; }
                            Rectangle { x: 0px; y: 2px; width: 22px; height: 15px; border-radius: 3px; background: #F59E0B; }
                            Rectangle { x: 2px; y: 5px; width: 18px; height: 2px;  border-radius: 1px; background: #FDE68A; }
                        }

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: parent.height - 4px;
                            width: root.files-open ? 14px : 0px;
                            height: 2px;
                            border-radius: 1px;
                            background: #1E2436;
                            animate width { duration: 190ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        }
                    }
                }
            }

            // 4) utility-content: Italian RTC clock & date (enlarged crisp typography, no divider bar)
            utility-content := HorizontalLayout {
                width: 132px;
                height: 100%;
                spacing: 0px;
                alignment: end;

                // Real RTC Clock & Date box (Europe/Rome CET/CEST)
                Rectangle {
                    width: 128px;
                    height: 38px;
                    y: 0px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: clock-ta.has-hover ? #FFFFFFBB : #FFFFFF55;
                    background: clock-ta.has-hover ? #FFFFFF84 : #FFFFFF44;
                    animate background { duration: 150ms; easing: ease-out; }
                    animate border-color { duration: 150ms; easing: ease-out; }

                    clock-ta := TouchArea {
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.clock-text;
                            color: #0F172A;
                            font-size: 13px;
                            font-weight: 700;
                            letter-spacing: 0.4px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.sub-clock-text;
                            color: #1E293B;
                            font-size: 10px;
                            font-weight: 600;
                            letter-spacing: 0.2px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
}
