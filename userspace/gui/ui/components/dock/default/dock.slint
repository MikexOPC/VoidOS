// Layer 2: Default Dock (userspace/gui/ui/components/dock/default/dock.slint)
// Frosted-glass blurred Dock:
//   - Real Gaussian-blurred backdrop (dock_blur.jpg) clipped inside border-radius: 14px + translucent glass tint
//   - Wider search-bar (216px) with uniform 8px spacing: shutdown <-> search-bar <-> app1
//   - Smooth Slint animations on hover, border, background, and active indicator
//   - Real hardware RTC clock & date from kernel bridge (SYS_DISPLAY_INFO)

export component DefaultDock inherits Rectangle {
    in property <length> screen-width: 1280px;
    in property <length> screen-height: 720px;
    in property <int> dock-mode: 0;
    in property <bool> terminal-open: true;
    in property <bool> sysmon-open: false;
    in property <bool> files-open: false;
    in property <image> backdrop-image;
    in property <string> clock-text: "15:44";
    in property <string> sub-clock-text: "24 Nov 2026";

    callback toggle-terminal();
    callback toggle-sysmon();
    callback toggle-files();
    callback shutdown-clicked();

    x: 44px;
    y: root.screen-height - 62px;
    width: root.screen-width - 88px;
    height: 50px;

    border-radius: 16px;
    background: transparent;

    // Clipped native blurred wallpaper backdrop + iOS Liquid Glass tint
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        clip: true;

        Image {
            width: 100%;
            height: 100%;
            source: root.backdrop-image;
            image-fit: fill;
        }

        // Translucent iOS Liquid Glass gradient overlay
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #FFFFFFA4 0%, #EEF3FC62 48%, #DCE5F852 100%);
            border-radius: 16px;
            border-width: 1px;
            border-color: #FFFFFFCC;
        }

        // Top Liquid Glass specular highlight rim
        Rectangle {
            x: 10px;
            y: 1px;
            width: parent.width - 20px;
            height: 1px;
            background: #FFFFFFF0;
        }

        // Subtle outer rim for contrast on any wallpaper
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 16px;
            border-width: 1px;
            border-color: #4F649048;
            background: transparent;
        }
    }

    dock-content := HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 8px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

            // 1) Shutdown button (38x38, no animation)
            shutdown-button := Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 15px;
                border-width: 1px;
                border-color: #8896B278;
                background: #FFFFFF58;

                shut-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.shutdown-clicked(); }
                }

                Image {
                    x: 10px;
                    y: 10px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../../../../libui/icons/on-off-button.png");
                }
            }

            // 2) Wider Search bar (216px, vertically centered inside 38px dock-content)
            Rectangle {
                width: 216px;
                height: 100%;
                background: transparent;

                search-bar := Rectangle {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: 100%;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 1px;
                    border-color: search-ta.has-hover ? #5E6E94AA : #8896B278;
                    background: search-ta.has-hover ? #FFFFFF84 : #FFFFFF60;
                    animate background { duration: 160ms; easing: ease-out; }
                    animate border-color { duration: 160ms; easing: ease-out; }

                    search-ta := TouchArea {
                        mouse-cursor: pointer;
                    }

                    HorizontalLayout {
                        height: 100%;
                        width: 100%;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 14px;
                            height: 100%;
                            background: transparent;
                            Image {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: 14px;
                                height: 14px;
                                source: @image-url("../../../../libui/icons/search.png");
                                colorize: #3A435E;
                            }
                        }

                        input := TextInput {
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: 600;
                            color: #1E2436;
                            text: "Search...";
                        }
                    }
                }
            }

            // 3) app-content: fluid hover lift animation + Liquid Glass tiles
            app-content := HorizontalLayout {
                horizontal-stretch: 1;
                height: 100%;
                spacing: 8px;
                alignment: start;

                // App 1: Terminal
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: transparent;

                    app1 := Rectangle {
                        x: 0px;
                        y: term-ta.has-hover ? -6px : 0px;
                        width: 38px;
                        height: 38px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: term-ta.has-hover ? #FFFFFFEE : (root.terminal-open ? #FFFFFFBB : #FFFFFF80);
                        background: term-ta.has-hover
                            ? @linear-gradient(180deg, #FFFFFFDC 0%, #EBF1FCC4 100%)
                            : (root.terminal-open
                                ? @linear-gradient(180deg, #FFFFFFA6 0%, #E6EEFB84 100%)
                                : @linear-gradient(180deg, #FFFFFF78 0%, #E6EEFB52 100%));
                        animate y { duration: 170ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate border-color { duration: 150ms; easing: ease-out; }

                        term-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-terminal(); }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            source: @image-url("../../../../application/terminal/icon/terminal.png");
                        }

                        Rectangle {
                            x: root.terminal-open ? 12px : 19px;
                            y: 34px;
                            width: root.terminal-open ? 14px : 0px;
                            height: 2px;
                            border-radius: 1px;
                            background: #1E2436;
                            animate width { duration: 180ms; easing: ease-out; }
                            animate x { duration: 180ms; easing: ease-out; }
                        }
                    }
                }

                // App 2: System Monitor
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: transparent;

                    app2 := Rectangle {
                        x: 0px;
                        y: sysmon-ta.has-hover ? -6px : 0px;
                        width: 38px;
                        height: 38px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: sysmon-ta.has-hover ? #FFFFFFEE : (root.sysmon-open ? #FFFFFFBB : #FFFFFF80);
                        background: sysmon-ta.has-hover
                            ? @linear-gradient(180deg, #FFFFFFDC 0%, #EBF1FCC4 100%)
                            : (root.sysmon-open
                                ? @linear-gradient(180deg, #FFFFFFA6 0%, #E6EEFB84 100%)
                                : @linear-gradient(180deg, #FFFFFF78 0%, #E6EEFB52 100%));
                        animate y { duration: 170ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate border-color { duration: 150ms; easing: ease-out; }

                        sysmon-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-sysmon(); }
                        }

                        // Minimal 3-bar System Monitor icon
                        Rectangle {
                            x: 9px;
                            y: 19px;
                            width: 5px;
                            height: 10px;
                            border-radius: 2px;
                            background: #22C55E;
                        }
                        Rectangle {
                            x: 16px;
                            y: 13px;
                            width: 5px;
                            height: 16px;
                            border-radius: 2px;
                            background: #3B82F6;
                        }
                        Rectangle {
                            x: 23px;
                            y: 16px;
                            width: 5px;
                            height: 13px;
                            border-radius: 2px;
                            background: #6366F1;
                        }

                        Rectangle {
                            x: root.sysmon-open ? 12px : 19px;
                            y: 34px;
                            width: root.sysmon-open ? 14px : 0px;
                            height: 2px;
                            border-radius: 1px;
                            background: #1E2436;
                            animate width { duration: 180ms; easing: ease-out; }
                            animate x { duration: 180ms; easing: ease-out; }
                        }
                    }
                }

                // App 3: Files
                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: transparent;

                    app3 := Rectangle {
                        x: 0px;
                        y: files-ta.has-hover ? -6px : 0px;
                        width: 38px;
                        height: 38px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: files-ta.has-hover ? #FFFFFFEE : (root.files-open ? #FFFFFFBB : #FFFFFF80);
                        background: files-ta.has-hover
                            ? @linear-gradient(180deg, #FFFFFFDC 0%, #EBF1FCC4 100%)
                            : (root.files-open
                                ? @linear-gradient(180deg, #FFFFFFA6 0%, #E6EEFB84 100%)
                                : @linear-gradient(180deg, #FFFFFF78 0%, #E6EEFB52 100%));
                        animate y { duration: 170ms; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                        animate border-color { duration: 150ms; easing: ease-out; }

                        files-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-files(); }
                        }

                        // Minimal folder icon
                        Rectangle {
                            x: 8px;
                            y: 11px;
                            width: 10px;
                            height: 4px;
                            border-radius: 2px;
                            background: #D97706;
                        }
                        Rectangle {
                            x: 8px;
                            y: 13px;
                            width: 22px;
                            height: 15px;
                            border-radius: 3px;
                            background: #F59E0B;
                        }
                        Rectangle {
                            x: 10px;
                            y: 16px;
                            width: 18px;
                            height: 2px;
                            border-radius: 1px;
                            background: #FDE68A;
                        }

                        Rectangle {
                            x: root.files-open ? 12px : 19px;
                            y: 34px;
                            width: root.files-open ? 14px : 0px;
                            height: 2px;
                            border-radius: 1px;
                            background: #1E2436;
                            animate width { duration: 180ms; easing: ease-out; }
                            animate x { duration: 180ms; easing: ease-out; }
                        }
                    }
                }
            }

            // Subtle vertical divider before Utility Zone
            Rectangle {
                width: 1px;
                height: 24px;
                y: 7px;
                background: #FFFFFF88;
            }

            // 4) utility-content: real RTC clock & date from kernel (Liquid Glass pill)
            utility-content := HorizontalLayout {
                width: 118px;
                height: 100%;
                spacing: 6px;
                alignment: end;

                // Real RTC Clock & Date box (bridged from kernel CMOS RTC)
                Rectangle {
                    width: 114px;
                    height: 34px;
                    y: 2px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: clock-ta.has-hover ? #FFFFFFEE : #FFFFFF99;
                    background: clock-ta.has-hover
                        ? @linear-gradient(180deg, #FFFFFFCC 0%, #EBF1FBB4 100%)
                        : @linear-gradient(180deg, #FFFFFF8C 0%, #E6EEFB68 100%);
                    animate border-color { duration: 150ms; easing: ease-out; }

                    clock-ta := TouchArea {
                        mouse-cursor: pointer;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.clock-text;
                            color: #182032;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.sub-clock-text;
                            color: #46506A;
                            font-size: 9px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
}
